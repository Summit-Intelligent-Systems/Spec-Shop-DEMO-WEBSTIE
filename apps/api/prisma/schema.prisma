// ============================================================
// XYZ Eyewear — Prisma Schema
// Database: PostgreSQL 16
// ORM: Prisma 5
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

enum FrameShape {
  ROUND
  SQUARE
  RECTANGLE
  OVAL
  CAT_EYE
  AVIATOR
  WAYFARER
  GEOMETRIC
  CLUBMASTER
  SPORT
}

enum FrameType {
  FULL_RIM
  HALF_RIM
  RIMLESS
}

enum FrameMaterial {
  METAL
  ACETATE
  TITANIUM
  TR90
  WOOD
  CARBON_FIBER
  MIXED
}

enum LensType {
  SINGLE_VISION
  PROGRESSIVE
  BIFOCAL
  TORIC
  MULTIFOCAL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  PAYPAL
  COD
  MOCK
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum NotificationType {
  ORDER_PLACED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  PRESCRIPTION_EXPIRING
  LOW_STOCK_ALERT
  REVIEW_APPROVED
  COUPON_EXPIRING
  MEMBERSHIP_EXPIRING
  SYSTEM
}

enum FaceShape {
  OVAL
  ROUND
  SQUARE
  HEART
  DIAMOND
  OBLONG
  TRIANGLE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  RECEIVED
  REFUND_INITIATED
  REFUND_COMPLETED
}

// ─── User & Auth ──────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?
  role               UserRole  @default(CUSTOMER)
  isVerified         Boolean   @default(false)
  isActive           Boolean   @default(true)
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecret    String?
  lastLoginAt        DateTime?
  loginAttempts      Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  profile            UserProfile?
  addresses          Address[]
  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  socialAccounts     SocialAccount[]
  cart               Cart?
  wishlist           WishlistItem[]
  orders             Order[]
  reviews            Review[]
  prescriptions      Prescription[]
  appointments       EyeTestAppointment[]
  membership         Membership?
  notifications      Notification[]
  reviewHelpful      ReviewHelpful[]
  mediaFiles         MediaFile[]
  blogPosts          BlogPost[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model UserProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  firstName   String
  lastName    String
  displayName String?
  phone       String?
  dateOfBirth DateTime?
  gender      Gender?
  avatarUrl   String?
  faceShape   FaceShape?
  bio         String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_profiles")
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  deviceInfo  String?
  ipAddress   String?
  userAgent   String?
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
}

model SocialAccount {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // google | facebook | apple
  providerId   String
  accessToken  String?
  refreshToken String?
  profile      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("social_accounts")
}

model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType @default(HOME)
  fullName   String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  pincode    String
  country    String      @default("India")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders  Order[]     @relation("ShippingAddress")
  billingOrders   Order[]     @relation("BillingAddress")

  @@index([userId])
  @@map("addresses")
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  bannerUrl   String?
  country     String?
  website     String?
  isPremium   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@map("brands")
}

model Product {
  id                     String        @id @default(cuid())
  name                   String
  slug                   String        @unique
  sku                    String        @unique
  shortDescription       String?
  description            String?
  brandId                String
  categoryId             String
  gender                 Gender        @default(UNISEX)
  shape                  FrameShape?
  frameType              FrameType?
  frameWidth             Int?          // in mm
  weight                 Int?          // in grams
  lensWidth              Int?          // in mm
  bridgeWidth            Int?          // in mm
  templeLength           Int?          // in mm
  lensHeight             Int?          // in mm
  prescriptionCompatible Boolean       @default(true)
  recommendedFaceShapes  FaceShape[]
  basePrice              Decimal       @db.Decimal(10, 2)
  baseComparePrice       Decimal?      @db.Decimal(10, 2)
  status                 ProductStatus @default(DRAFT)
  isFeatured             Boolean       @default(false)
  isNewArrival           Boolean       @default(false)
  isBestSeller           Boolean       @default(false)
  tags                   String[]
  averageRating          Decimal       @default(0) @db.Decimal(3, 2)
  reviewCount            Int           @default(0)
  viewCount              Int           @default(0)
  purchaseCount          Int           @default(0)
  metaTitle              String?
  metaDesc               String?
  warrantyInfo           String?
  careInstructions       String?
  sortOrder              Int           @default(0)
  publishedAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  brand        Brand            @relation(fields: [brandId], references: [id])
  category     Category         @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  media        ProductMedia[]
  reviews      Review[]
  cartItems    CartItem[]
  wishlistItems WishlistItem[]
  orderItems   OrderItem[]
  inventories  Inventory[]

  @@index([slug])
  @@index([sku])
  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([isBestSeller])
  @@map("products")
}

model ProductVariant {
  id           String        @id @default(cuid())
  productId    String
  sku          String        @unique
  color        String?
  colorHex     String?
  size         String?
  frameWidth   Int?
  frameMaterial FrameMaterial?
  lensType     LensType?
  price        Decimal       @db.Decimal(10, 2)
  comparePrice Decimal?      @db.Decimal(10, 2)
  stock        Int           @default(0)
  isDefault    Boolean       @default(false)
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  images        ProductMedia[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  inventories   Inventory[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  variantId String?
  url       String
  type      MediaType @default(IMAGE)
  altText   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@map("product_media")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Inventory {
  id                String   @id @default(cuid())
  productId         String
  variantId         String?
  storeId           String?
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int      @default(5)
  reorderPoint      Int?
  reorderQuantity   Int?
  lastRestockedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  store   Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([productId, variantId, storeId])
  @@index([productId])
  @@index([variantId])
  @@map("inventory")
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id          String   @id @default(cuid())
  userId      String?  @unique
  sessionId   String?  @unique
  couponId    String?
  subtotal    Decimal  @default(0) @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  tax         Decimal  @default(0) @db.Decimal(10, 2)
  total       Decimal  @default(0) @db.Decimal(10, 2)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id])
  items  CartItem[]

  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id              String   @id @default(cuid())
  cartId          String
  productId       String
  variantId       String
  quantity        Int      @default(1)
  prescriptionId  String?
  unitPrice       Decimal  @db.Decimal(10, 2)
  isSavedForLater Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cart         Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  prescription Prescription?  @relation(fields: [prescriptionId], references: [id])

  @@unique([cartId, variantId, isSavedForLater])
  @@index([cartId])
  @@map("cart_items")
}

// ─── Wishlist ─────────────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  addedAt   DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod @default(MOCK)
  paymentId         String?
  paymentGatewayRef String?
  shippingAddressId String
  billingAddressId  String?
  subtotal          Decimal       @db.Decimal(10, 2)
  discount          Decimal       @default(0) @db.Decimal(10, 2)
  couponCode        String?
  couponDiscount    Decimal       @default(0) @db.Decimal(10, 2)
  shippingCharge    Decimal       @default(0) @db.Decimal(10, 2)
  tax               Decimal       @default(0) @db.Decimal(10, 2)
  total             Decimal       @db.Decimal(10, 2)
  trackingNumber    String?
  trackingUrl       String?
  shippingProvider  String?
  notes             String?
  adminNotes        String?
  invoiceUrl        String?
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user            User        @relation(fields: [userId], references: [id])
  shippingAddress Address     @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?    @relation("BillingAddress", fields: [billingAddressId], references: [id])
  items           OrderItem[]
  returns         Return[]
  notifications   Notification[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  productName    String   // Snapshot at time of order
  variantDetails Json?    // Snapshot of variant details
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  totalPrice     Decimal  @db.Decimal(10, 2)
  prescriptionId String?
  createdAt      DateTime @default(now())

  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  prescription Prescription?  @relation(fields: [prescriptionId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Return {
  id          String       @id @default(cuid())
  orderId     String
  reason      String
  description String?
  status      ReturnStatus @default(REQUESTED)
  refundAmount Decimal?    @db.Decimal(10, 2)
  images      String[]
  adminNotes  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("returns")
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id                String       @id @default(cuid())
  userId            String
  productId         String
  rating            Int
  title             String
  body              String
  isVerifiedPurchase Boolean     @default(false)
  status            ReviewStatus @default(PENDING)
  helpfulCount      Int          @default(0)
  images            String[]
  adminNotes        String?
  moderatedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  helpful  ReviewHelpful[]

  @@unique([userId, productId])
  @@index([productId])
  @@index([status])
  @@index([rating])
  @@map("reviews")
}

model ReviewHelpful {
  id       String   @id @default(cuid())
  userId   String
  reviewId String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@map("review_helpful")
}

// ─── Coupons ──────────────────────────────────────────────────────────────────

model Coupon {
  id                   String     @id @default(cuid())
  code                 String     @unique
  name                 String
  description          String?
  type                 CouponType
  value                Decimal    @db.Decimal(10, 2)
  minOrderAmount       Decimal?   @db.Decimal(10, 2)
  maxDiscountAmount    Decimal?   @db.Decimal(10, 2)
  maxUses              Int?
  usedCount            Int        @default(0)
  perUserLimit         Int?       @default(1)
  isActive             Boolean    @default(true)
  startsAt             DateTime?
  expiresAt            DateTime?
  applicableCategories String[]
  applicableProducts   String[]
  applicableBrands     String[]
  excludeProducts      String[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  carts      Cart[]
  usageLogs  CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String?
  usedAt    DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_usages")
}

// ─── Prescriptions ────────────────────────────────────────────────────────────

model Prescription {
  id               String    @id @default(cuid())
  userId           String
  name             String    @default("My Prescription")
  // Right Eye (OD - Oculus Dexter)
  rightSph         Decimal?  @db.Decimal(5, 2)
  rightCyl         Decimal?  @db.Decimal(5, 2)
  rightAxis        Int?
  rightAdd         Decimal?  @db.Decimal(5, 2)
  rightPrism       Decimal?  @db.Decimal(5, 2)
  rightVa          String?
  // Left Eye (OS - Oculus Sinister)
  leftSph          Decimal?  @db.Decimal(5, 2)
  leftCyl          Decimal?  @db.Decimal(5, 2)
  leftAxis         Int?
  leftAdd          Decimal?  @db.Decimal(5, 2)
  leftPrism        Decimal?  @db.Decimal(5, 2)
  leftVa           String?
  // PD
  pd               Decimal?  @db.Decimal(5, 2)
  rightPd          Decimal?  @db.Decimal(5, 2)
  leftPd           Decimal?  @db.Decimal(5, 2)
  // Meta
  doctorName       String?
  hospitalName     String?
  prescriptionDate DateTime?
  expiresAt        DateTime?
  fileUrl          String?   // Uploaded prescription image
  notes            String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([userId])
  @@map("prescriptions")
}

// ─── Stores & Appointments ────────────────────────────────────────────────────

model Store {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  address        String
  city           String
  state          String
  pincode        String
  country        String   @default("India")
  phone          String
  email          String?
  lat            Decimal? @db.Decimal(10, 7)
  lng            Decimal? @db.Decimal(10, 7)
  operatingHours Json     // StoreHours JSON
  services       String[] // e.g. ['eye_test', 'lens_fitting', 'repairs']
  isActive       Boolean  @default(true)
  imageUrl       String?
  managerName    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointments EyeTestAppointment[]
  inventories  Inventory[]

  @@index([city])
  @@index([pincode])
  @@map("stores")
}

model EyeTestAppointment {
  id            String            @id @default(cuid())
  userId        String
  storeId       String
  date          DateTime
  timeSlot      String
  status        AppointmentStatus @default(PENDING)
  doctorName    String?
  notes         String?
  reminderSent  Boolean           @default(false)
  cancelReason  String?
  confirmedAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([userId])
  @@index([storeId])
  @@index([date])
  @@index([status])
  @@map("eye_test_appointments")
}

// ─── Membership ───────────────────────────────────────────────────────────────

model MembershipPlan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  duration     Int      // Number of months
  benefits     Json     // Array of MembershipBenefit objects
  discountPercent Int   @default(0)
  freeEyeTests Int      @default(0)
  freeShipping Boolean  @default(false)
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("membership_plans")
}

model Membership {
  id          String           @id @default(cuid())
  userId      String           @unique
  planId      String
  status      MembershipStatus @default(ACTIVE)
  startsAt    DateTime
  endsAt      DateTime
  autoRenew   Boolean          @default(false)
  paymentId   String?
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([endsAt])
  @@map("memberships")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  metadata  Json?
  actionUrl String?
  orderId   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─── CMS ──────────────────────────────────────────────────────────────────────

model CmsPage {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean      @default(false)
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sections CmsSection[]

  @@index([slug])
  @@index([isPublished])
  @@map("cms_pages")
}

model CmsSection {
  id        String   @id @default(cuid())
  pageId    String
  type      String   // hero | banner | collection | testimonial | faq | text | etc.
  name      String?
  content   Json
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("cms_sections")
}

model CmsGlobal {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  label     String?
  group     String?  // navigation | footer | seo | social | contact | etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("cms_global")
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

model BlogPost {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  excerpt      String?
  content      String
  coverImageUrl String?
  authorId     String
  tags         String[]
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  viewCount    Int       @default(0)
  readTime     Int?      // minutes
  metaTitle    String?
  metaDesc     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("blog_posts")
}

// ─── Media ────────────────────────────────────────────────────────────────────

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  slug      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children MediaFolder[] @relation("FolderTree")
  files    MediaFile[]

  @@unique([slug, parentId])
  @@index([parentId])
  @@map("media_folders")
}

model MediaFile {
  id         String    @id @default(cuid())
  url        String
  key        String    @unique // Storage key (S3 key, Cloudinary public_id, or local path)
  type       MediaType
  mimeType   String
  size       Int       // bytes
  width      Int?
  height     Int?
  duration   Float?    // video duration in seconds
  altText    String?
  folderId   String?
  uploadedBy String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploader User         @relation(fields: [uploadedBy], references: [id])

  @@index([folderId])
  @@index([type])
  @@index([uploadedBy])
  @@map("media_files")
}

// ─── Analytics ────────────────────────────────────────────────────────────────

model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  sessionId String?
  ipAddress String?
  userAgent String?
  referrer  String?
  viewedAt  DateTime @default(now())

  @@index([productId])
  @@index([viewedAt])
  @@map("product_views")
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  results   Int      @default(0)
  userId    String?
  sessionId String?
  clickedId String?  // Product ID that was clicked from results
  searchedAt DateTime @default(now())

  @@index([query])
  @@index([searchedAt])
  @@map("search_logs")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  userName   String   // Snapshot of user name at time of action
  action     String   // CREATE | UPDATE | DELETE | STATUS_CHANGE | LOGIN | etc.
  entity     String   // Product | Order | Category | CmsPage | etc.
  entityId   String?
  entityName String?  // Human-readable name of the entity (e.g. product name)
  details    Json?    // What changed (before/after or extra context)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Content Pages (Rich Text) ────────────────────────────────────────────────

model ContentPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String   // Rich text HTML content
  excerpt         String?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("content_pages")
}

// ─── Site Settings (Global Key-Value) ─────────────────────────────────────────

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  type      String   @default("string") // string | number | boolean | json | image
  label     String?
  group     String   @default("general") // general | branding | contact | email | tax | shipping | payment
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("site_settings")
}

// ─── Promotions ───────────────────────────────────────────────────────────────

enum PromotionType {
  FLASH_SALE
  SEASONAL
  CLEARANCE
  BUNDLE
  BOGO
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  EXPIRED
  CANCELLED
}

model Promotion {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String?
  type            PromotionType
  status          PromotionStatus @default(DRAFT)
  discountType    CouponType      @default(PERCENTAGE)
  discountValue   Decimal         @db.Decimal(10, 2)
  bannerImageUrl  String?
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean         @default(true)
  applicableProducts   String[]
  applicableCategories String[]
  applicableBrands     String[]
  minOrderAmount  Decimal?        @db.Decimal(10, 2)
  maxDiscountAmount Decimal?      @db.Decimal(10, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([slug])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@map("promotions")
}
