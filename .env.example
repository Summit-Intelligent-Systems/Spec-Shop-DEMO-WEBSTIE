# ============================================================
# XYZ Eyewear — Root Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# ============================================================

# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
APP_NAME="XYZ Eyewear"
APP_URL=http://localhost:3000

# ─── API ────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
API_PREFIX=/api/v1

# ─── Database (PostgreSQL / Supabase) ────────────────────────
# Use Supavisor connection-pooled URL on port 6543 for DATABASE_URL
# Use Direct connection URL on port 5432 for DIRECT_URL (migrations)
DATABASE_URL=postgresql://xyz_user:xyz_password@localhost:5432/xyz_eyewear_db
DIRECT_URL=postgresql://xyz_user:xyz_password@localhost:5432/xyz_eyewear_db
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT Authentication ──────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret_64_chars
JWT_REFRESH_EXPIRES_IN=30d
JWT_EMAIL_VERIFY_SECRET=change_this_for_email_verification_tokens
JWT_EMAIL_VERIFY_EXPIRES_IN=24h
JWT_PASSWORD_RESET_SECRET=change_this_for_password_reset_tokens
JWT_PASSWORD_RESET_EXPIRES_IN=1h

# ─── CORS ───────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM_NAME="XYZ Eyewear"
SMTP_FROM_EMAIL=noreply@xyzeyewear.com
SMTP_REPLY_TO=support@xyzeyewear.com

# ─── Storage ─────────────────────────────────────────────────
# Options: local | s3 | cloudinary | supabase
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm

# Supabase Storage (only needed if STORAGE_DRIVER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=media

# AWS S3 (only needed if STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=xyz-eyewear-media
AWS_S3_BASE_URL=https://xyz-eyewear-media.s3.ap-south-1.amazonaws.com

# Cloudinary (only needed if STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=xyz-eyewear

# ─── Payment Gateway ─────────────────────────────────────────
# Options: mock | razorpay | stripe | paypal
PAYMENT_DRIVER=mock

# Razorpay (India-first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (Global)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ─── Notifications ───────────────────────────────────────────
# Push Notifications (FCM)
FCM_SERVER_KEY=

# SMS (placeholder — Twilio or MSG91)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Social Login (OAuth) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/v1/auth/facebook/callback

# ─── Next.js (Public - exposed to browser) ──────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="XYZ Eyewear"
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_HOTJAR_ID=

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ─── Security ────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=change_this_to_a_random_session_secret
CSRF_SECRET=change_this_to_a_random_csrf_secret

# ─── pgAdmin (Docker dev only) ───────────────────────────────
PGADMIN_EMAIL=admin@xyzeyewear.com
PGADMIN_PASSWORD=admin_password_dev

# ─── Business Configuration ──────────────────────────────────
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_LOCALE=en-IN
DEFAULT_TIMEZONE=Asia/Kolkata
TAX_RATE=18
FREE_SHIPPING_THRESHOLD=999
DEFAULT_SHIPPING_CHARGE=99
LOW_STOCK_THRESHOLD=5
PAGINATION_DEFAULT_LIMIT=24

# ─── Feature Flags ───────────────────────────────────────────
FEATURE_VIRTUAL_TRYON=false
FEATURE_FACE_SHAPE_QUIZ=true
FEATURE_EYE_TEST_BOOKING=true
FEATURE_MEMBERSHIP=true
FEATURE_BLOG=true
FEATURE_STORE_LOCATOR=true
FEATURE_2FA=false
